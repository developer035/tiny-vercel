# Cloudflare R2 credentials
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Project details
PROJECT_ID=
OUTPUT_DIR=dist
GIT_REPOSITORY_URL=

# Aiven Apache Kafka configuration
KAFKA_BROKER=
KAFKA_USERNAME=
KAFKA_PASSWORD=
# Directly pass PEM contents in ENV (recommended - no cert file needed in container):
# KAFKA_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# Or file path:
KAFKA_CA_PATH=kafka.pem
# KAFKA_SASL_MECHANISM=plain
