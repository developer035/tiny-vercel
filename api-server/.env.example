# API Server Configuration
PORT=9000

# Google Cloud Run Job Configuration
GCP_PROJECT_ID=
GCP_REGION=asia-south1
CLOUD_RUN_JOB=tiny-vercel

# Neon PostgreSQL connection string (e.g. postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require)
DATABASE_URL=

# Aiven Apache Kafka (same cluster as build-server)
KAFKA_BROKER=
KAFKA_USERNAME=
KAFKA_PASSWORD=
# Directly pass PEM contents in ENV (recommended - no cert file needed in container):
# KAFKA_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# Or file path:
KAFKA_CA_PATH=kafka.pem
# KAFKA_SASL_MECHANISM=plain
# KAFKA_TOPIC=container-logs

# Aiven ClickHouse Configuration
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=avnadmin
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=default
